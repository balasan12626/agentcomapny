# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/datylune?replicaSet=rs0
REDIS_URL=redis://localhost:6379
# >= 32 random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
MAX_PARALLEL_AGENTS=3
MAX_DELEGATION_DEPTH=6
RATE_LIMIT_PER_MIN=300
# Claude Code CLI path (uses the existing local Claude Code login; no API key needed here)
CLAUDE_BIN=claude
# Integration tests against a real MongoDB replica set (optional)
MONGODB_TEST_URI=
